<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <system.serviceModel>
    <services>
      <service name="WCFHost.CalculatorService" behaviorConfiguration="CalculatorBehavior">
        <host>
          <baseAddresses>
            <add baseAddress="http://localhost:8080/CalculatorService" />
            <add baseAddress="net.tcp://localhost:8090/CalculatorService" />
          </baseAddresses>
        </host>

        <!-- HTTP (SOAP 1.1, interoperable) -->
        <endpoint address=""
                  binding="basicHttpBinding"
                  contract="WCFHost.Contracts.ICalculatorService" />

        <!-- TCP (fast, .NET-to-.NET) -->
        <endpoint address=""
                  binding="netTcpBinding"
                  bindingConfiguration="TcpNoSecurity"
                  contract="WCFHost.Contracts.ICalculatorService" />

        <!-- Metadata (WSDL) -->
        <endpoint address="mex"
                  binding="mexHttpBinding"
                  contract="IMetadataExchange" />
      </service>
    </services>

    <bindings>
      <netTcpBinding>
        <binding name="TcpNoSecurity">
          <security mode="None" />
        </binding>
      </netTcpBinding>
    </bindings>

    <behaviors>
      <serviceBehaviors>
        <behavior name="CalculatorBehavior">
          <serviceMetadata httpGetEnabled="true" />
          <!-- set to false in production -->
          <serviceDebug includeExceptionDetailInFaults="true" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
  </system.serviceModel>
</configuration>